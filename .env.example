# Postgres (docker compose up -d uses these credentials)
DATABASE_URL="postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="replace-me"
AUTH_URL="http://localhost:3000"

# Password used for every seeded account (dev only)
SEED_PASSWORD="Password123!"

# Public base URL, used for canonical links, sitemap and structured data
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Payments. "test" is a built-in stand-in with Approve/Decline buttons and no
# real money; it is disabled in production unless ALLOW_TEST_PAYMENTS=true.
PAYMENT_PROVIDER="test"
# Shared secret for verifying payment webhooks (32+ random characters)
PAYMENT_WEBHOOK_SECRET="replace-me-with-a-long-random-string"

# Protects /api/cron/* (send as: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="replace-me-with-a-long-random-string"
